FROM postgis/postgis:15-3.4

# Instala TimescaleDB + pg_cron
RUN apt-get update && \
    apt-get install -y gnupg curl && \
    curl -s https://packagecloud.io/install/repositories/timescale/timescaledb/script.deb.sh | bash && \
    apt-get update && \
    apt-get install -y \
        timescaledb-2-postgresql-15 \
        postgresql-15-cron && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Cria diretório de configuração se não existir
RUN mkdir -p /etc/postgresql/15/main/

# Configura pg_cron (será copiado para o data dir na inicialização)
RUN echo "shared_preload_libraries = 'timescaledb,pg_cron'" >> /etc/postgresql/15/main/postgresql.conf && \
    echo "cron.database_name = 'locker_central'" >> /etc/postgresql/15/main/postgresql.conf

    