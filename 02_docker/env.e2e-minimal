# Ambiente mínimo para E2E P0–P2 (compose + script). Valores só para CI/lab — não usar em produção.
# P2: POST /orders com X-Dev-Bypass-Auth (só com DEV_BYPASS_AUTH=true).
DEV_BYPASS_AUTH=true
# Utilizador do pedido (orders.user_id): o script resolve por email por omissão (admin.operacao@ellanlab.com)
# ou E2E_USER_ID / E2E_USER_EMAIL no ambiente ao correr 07_tests/e2e_payment_minimal_stack.sh — não é obrigatório duplicar aqui.
# E2E P1 (gateway): relaxar motor de risco só em lab/CI — nunca em produção.
GATEWAY_E2E_RELAX_RISK=true
ORDER_INTERNAL_TOKEN=e2e_ci_internal_token_change_me_in_github_secret
LOG_HASH_SALT=e2e_ci_log_hash_salt_min_32_chars_x12345678901234567890123456789012
ANTIFRAUD_ACTIVE_PEPPER_VERSION=v1
ANTIFRAUD_PEPPER_V1=e2e_antifraud_pepper_v1_min_length_dummy_value_for_ci_only_xx
ANTIFRAUD_PEPPER_V2=e2e_antifraud_pepper_v2_min_length_dummy_value_for_ci_only_xx
ANTIFRAUD_PEPPER=e2e_antifraud_pepper_main_min_length_dummy_value_ci_only_xx
GATEWAY_ID=payment_gateway_e2e
DEFAULT_LOCKER_ID=SP-CARAPICUIBA-JDMARILU-LK-002
LOCKER_ID_PT=PT-GUIMARAES-AZUREM-LK-001
LOCKER_ID_SP=SP-CARAPICUIBA-JDMARILU-LK-002
LOCKER_REGISTRY_JSON={"SP-CARAPICUIBA-JDMARILU-LK-002":{"region":"SP","site_id":"site_sp","display_name":"Carapicuiba JD Marilu 002","backend_region":"SP","slots":60,"channels":["ONLINE","KIOSK"],"payment_methods":["PIX","CARTAO"],"active":true,"address":{"country":"BR"}},"SP-VILAOLIMPIA-FOOD-LK-001":{"region":"SP","site_id":"site_sp","display_name":"SP","backend_region":"SP","slots":24,"channels":["ONLINE","KIOSK"],"payment_methods":["PIX","CARTAO"],"active":true,"address":{"country":"BR"}},"PT-GUIMARAES-AZUREM-LK-001":{"region":"PT","site_id":"site_pt","display_name":"PT","backend_region":"PT","slots":24,"channels":["ONLINE","KIOSK"],"payment_methods":["MBWAY","CARTAO"],"active":true,"address":{"country":"PT"}}}
MERCADOPAGO_ACCESS_TOKEN=e2e_dummy_mp
STRIPE_SECRET_KEY_PT=e2e_dummy_stripe_pt
STRIPE_SECRET_KEY_SP=e2e_dummy_stripe_sp
PICKUP_QR_SECRET=e2e_pickup_qr_secret_min_length_dummy_value_for_ci_only_xx
QR_ROTATE_SEC=600
DEV_DEFAULT_PRICE_CENTS=1000
DEV_DEFAULT_CURRENCY=BRL
