{
  "title": "ELLAN — Migração monólito → microserviços",
  "uid": "ellan-migration",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Divergência (price / total pedidos)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(divergence_price) / sum(total_orders)",
          "legendFormat": "divergence_ratio"
        }
      ]
    },
    {
      "id": 2,
      "title": "Tráfego v1 / v2 (ratio)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(requests{version=\"v1\"}) / sum(requests{version=\"v2\"})",
          "legendFormat": "v1_over_v2"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error / partner (ratio)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(errors) by (partner_id) / sum(requests) by (partner_id)",
          "legendFormat": "{{partner_id}}"
        }
      ]
    }
  ]
}
